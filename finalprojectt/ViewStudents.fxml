<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
    prefHeight="480.0" prefWidth="640.0"
    xmlns="http://javafx.com/javafx/19"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.mycompany.finalprojectt.ViewStudentsController">
    <children>

        <!-- Background image -->
        <ImageView fitHeight="480.0" fitWidth="640.0" opacity="0.85" pickOnBounds="true" preserveRatio="false">
            <image>
                <Image url="@AddStBG.png" />
            </image>
        </ImageView>

        <!-- Main layout -->
        <VBox spacing="15" style="-fx-padding: 40;">

            <!-- Title -->
            <Label text="View Student" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #3a7bd5;" />
            <Label text="Select a student ID to view their details" style="-fx-font-size: 12px; -fx-text-fill: #666666;" />

            <!-- Card -->
            <VBox spacing="12" style="-fx-background-color: #ffffffdd; -fx-padding: 20; -fx-background-radius: 10;">

                <Label text="Student ID:" style="-fx-font-size: 13px;" />

                <!-- ComboBox + Button -->
                <HBox spacing="10">
                    <ComboBox fx:id="StdIds" prefWidth="200.0" />
                    <Button fx:id="addgrade" mnemonicParsing="false" onAction="#showStudent" text="Show Details"
                        style="-fx-background-color: #3a7bd5; -fx-text-fill: white; -fx-background-radius: 5;" />
                </HBox>

                <Label text="Student Info:" style="-fx-font-size: 13px; -fx-font-weight: bold;" />

                <!-- Result label -->
                <Label fx:id="reslbl" wrapText="true" lineSpacing="5" style="-fx-font-size: 13px;" />
            </VBox>

            <!-- Back button -->
            <Button mnemonicParsing="false" onAction="#Back" text="Back"
                style="-fx-background-color: #3a7bd5; -fx-text-fill: white; -fx-background-radius: 5;" />
        </VBox>
    </children>
</StackPane>